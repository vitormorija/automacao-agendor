# ── Agendor API ──────────────────────────────────────────────────
AGENDOR_TOKEN=seu-token-aqui

# ── Servidor ─────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── Segurança / Autenticação ─────────────────────────────────────
# OBRIGATÓRIO: segredo de assinatura dos tokens JWT (mín. 16 caracteres).
# Gere um valor forte com: openssl rand -hex 32
JWT_SECRET=troque-por-um-segredo-forte-e-aleatorio

# Usuário administrador inicial (criado apenas no primeiro boot, se não houver
# nenhum usuário cadastrado). Depois, gerencie usuários pela aplicação.
SEED_ADMIN_EMAIL=admin@cadmus.com.br
SEED_ADMIN_PASSWORD=troque-no-primeiro-acesso

# E-mails autorizados a gerenciar usuários (separados por vírgula).
# Se vazio, qualquer usuário autenticado tem acesso (defina em produção).
ADMIN_USERS=admin@cadmus.com.br

# ── CORS: origens permitidas (separe por vírgula) ─────────────────
# Em desenvolvimento deixe em branco (aceita localhost)
# Em produção coloque o domínio/IP do servidor
ALLOWED_ORIGINS=http://agendor.cadmus.com.br

# ── Base URL (para links nos emails) ─────────────────────────────
BASE_URL=http://agendor.cadmus.com.br

# ── Configurações de email SMTP ───────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-app-gmail
SMTP_FROM=Automação Agendor <seu-email@gmail.com>

# ── Email do administrador ────────────────────────────────────────
ADMIN_EMAIL=admin@cadmus.com.br

# ── Quantos dias sem atualização para alertar ─────────────────────
STALE_DAYS=15
