# Copie este arquivo para backend/.env e preencha os valores reais.
# Um único .env por máquina: quem decide o rigor e o comportamento é NODE_ENV (D-07).
# Os valores abaixo são PLACEHOLDERS propositalmente óbvios — nunca cole aqui um
# segredo real, este arquivo é versionado e público.

# ── Ambiente ─────────────────────────────────────────────────────
# development (padrão) = obrigatória ausente vira só um aviso no log, logs em texto,
#                        frontend servido pelo Vite (porta 5173).
# production           = boot ABORTA se faltar obrigatória, logs em JSON,
#                        o backend serve o frontend/dist já buildado.
NODE_ENV=production                    # [dev: 'development' ou deixe em branco]

# ── OBRIGATÓRIAS (o boot aborta em produção se faltar) ───────────
# Contrato espelhado de backend/src/config.js (REQUIRED). Em desenvolvimento a
# ausência de qualquer uma vira aviso e o processo sobe assim mesmo (D-05).
AGENDOR_TOKEN=seu-token-aqui           # painel Agendor › Configurações › API
JWT_SECRET=troque-por-um-segredo-forte-e-aleatorio   # OBRIGATÓRIO 64 caracteres (32 bytes): openssl rand -hex 32
                                       # ⚠️ ORDEM DE DEPLOY: gere e publique o segredo NOVO no servidor
                                       #    ANTES de subir código que exija o piso maior — invertido, o
                                       #    `pm2 restart` seguinte não levanta (src/secret.js aborta o boot).
                                       # ROTAÇÃO: a cada 6 meses, ou imediatamente após saída de alguém com
                                       #    acesso ao servidor / suspeita de vazamento. Trocar invalida TODAS
                                       #    as sessões ativas — todos entram de novo. Não há downtime.
SMTP_PASS=sua-senha-de-app-aqui        # único segredo SMTP no ambiente — os demais campos ficam na UI
ALLOWED_ORIGINS=http://agendor.cadmus.com.br         # origens do CORS, separadas por vírgula [dev: em branco aceita localhost]
ADMIN_USERS=admin@cadmus.com.br        # e-mails que podem gerenciar usuários (vírgula)

# ── OPCIONAIS (têm default sensato no código) ────────────────────
PORT=3001                              # default 3001
LOG_LEVEL=info                         # error|warn|info|debug — default info
DB_PATH=./agendor.db                   # default backend/agendor.db
LOG_DIR=                               # VAZIO de propósito: cai no default (a pasta logs/ na raiz)
                                       # que é a que ecosystem.config.js e deploy/backup.sh referenciam.
                                       # Existe como seam para a suíte não escrever no logs/ real; em
                                       # produção, deixe SEM valor.
EMAIL_INTERVALO_MS=3000                # pausa entre envios da mesma rodada — default 3000 (3s)
                                       # Protege contra o LIMITE DE CONEXÕES do provedor SMTP, não o de
                                       # volume: cada notificação abre uma conexão própria. Em 17/08/2026,
                                       # 40 envios em 67s levaram um `451 queue file write error` da
                                       # Locaweb. Aumente se o provedor for mais restritivo; 0 desliga.
                                       # Valor relativo resolve contra backend/src/, e NÃO contra o
                                       # diretório de trabalho: sob PM2 (cwd /opt/agendor) um caminho
                                       # relativo ao cwd cairia em /opt/logs e o operador abriria um
                                       # error.log vazio enquanto os stack traces estariam noutro lugar.
BASE_URL=http://agendor.cadmus.com.br  # URL pública do backend, usada nos links rastreáveis dos e-mails
                                       # [dev: em branco desliga o tracking de cliques]
BASE_URL_FRONTEND=http://localhost:5173  # base do link de redefinição de senha
                                       # [prod: http://agendor.cadmus.com.br]
ADMIN_EMAIL=admin@cadmus.com.br        # destinatário do resumo semanal; semeia a tabela config no 1º boot
SMTP_HOST=smtp.gmail.com               # default smtp.gmail.com — depois do 1º boot, edite pela UI
SMTP_PORT=587                          # default 587 — depois do 1º boot, edite pela UI
SMTP_USER=seu-email@gmail.com          # depois do 1º boot, edite pela UI
SMTP_FROM=Automação Agendor <seu-email@gmail.com>    # remetente exibido; depois do 1º boot, edite pela UI

# Usuário administrador inicial: criado APENAS no primeiro boot, se não houver
# nenhum usuário cadastrado. Depois disso, gerencie usuários pela aplicação.
SEED_ADMIN_EMAIL=admin@cadmus.com.br   # só tem efeito no banco vazio
SEED_ADMIN_PASSWORD=troque-no-1o-acesso  # só tem efeito no banco vazio

# Nota: o limite de dias sem atualização (stale_days) NÃO é variável de ambiente.
# Ele mora na tabela `config` do SQLite (default 15) e é editável pela aba
# Configurações do painel. Documentá-lo aqui seria mentira (D-12).
