# ── Agendor API ──────────────────────────────────────────────────
AGENDOR_TOKEN=seu-token-aqui

# ── Servidor ─────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ── CORS: origens permitidas (separe por vírgula) ─────────────────
# Em desenvolvimento deixe em branco (aceita localhost)
# Em produção coloque o domínio/IP do servidor
ALLOWED_ORIGINS=http://agendor.cadmus.com.br

# ── Base URL (para links nos emails) ─────────────────────────────
BASE_URL=http://agendor.cadmus.com.br

# ── Configurações de email SMTP ───────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-app-gmail
SMTP_FROM=Automação Agendor <seu-email@gmail.com>

# ── Email do administrador ────────────────────────────────────────
ADMIN_EMAIL=admin@cadmus.com.br

# ── Quantos dias sem atualização para alertar ─────────────────────
STALE_DAYS=15
